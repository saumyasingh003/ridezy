# Copy to .env and fill in real values. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string, including the database name (/ridezy)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/ridezy?retryWrites=true&w=majority

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Key used to HMAC-hash email OTPs (must differ from JWT_SECRET)
OTP_SECRET=

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000

# Driver location: seconds before a location counts as stale, and the
# default radius (meters) for nearby-driver searches.
LOCATION_STALE_AFTER_SECONDS=60
NEARBY_SEARCH_RADIUS_METERS=5000

# Routing: "osrm" (road routes) or "haversine" (offline straight-line estimate).
# The public OSRM demo server is for development only (~1 req/s, no SLA);
# self-host OSRM for production and point OSRM_BASE_URL at it.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_MS=5000

# Rides & matching
MAX_RIDE_DISTANCE_KM=100
MATCHING_BATCH_SIZE=3
RIDE_SEARCH_TIMEOUT_SECONDS=300

# SMTP settings. Required in production. In development, leave them empty to
# use a throwaway Ethereal inbox (a preview link is logged for each email).
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Ridezy <your-email@gmail.com>

# Only read by `npm run create-admin`. Remove the password after running it.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
