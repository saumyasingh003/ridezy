# Copy to .env.local for local overrides. On Vercel: Project → Settings →
# Environment Variables. NEXT_PUBLIC_ values are built into the browser bundle,
# so never put secrets here. Changing them requires a rebuild/redeploy.

# Backend API base URL, including /api (no trailing slash).
# Local default if unset: http://localhost:5000/api
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
